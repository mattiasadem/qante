{
  "pageType": "policy",
  "label": {
    "en": "Legal",
    "tr": "Yasal",
    "de": "Rechtliches"
  },
  "source": "Main 3-column sticky spec (authoritative) + Kreis-001 CUSTOM intent (remote; single-column Heading+Text in theme.json today)",
  "layout": {
    "type": "three-column-sticky",
    "columns": {
      "left": {
        "role": "in-page-toc",
        "schemaId": "policy-toc-nav",
        "sticky": true,
        "description": "This page's content headings as anchor links jumping to middle-column sections"
      },
      "center": {
        "role": "legal-body",
        "schemaIds": ["page-content-main", "editorial-separator"],
        "description": "Heading + Text (Kreis); optional Separator between body blocks"
      },
      "right": {
        "role": "sibling-policy-links",
        "schemaId": "policy-sibling-nav",
        "sticky": true,
        "description": "Links to other legal pages (Privacy, Terms, Cookie) — not footer yasalLinkler"
      }
    },
    "wrapper": {
      "schemaId": "policy-page-layout",
      "scope": "page-template",
      "styleKnobs": ["layout three-column|stacked", "kolon 3", "solSticky", "sagSticky", "mobilAccordion"]
    },
    "mobile": "Left/right sticky rails collapse — typically TOC + sibling nav become top/bottom accordion (mobilAccordion on wrapper and rails; not a fourth layout invented)"
  },
  "ikasPageShape": {
    "type": "CUSTOM",
    "stack": [
      "Header",
      "policy-page-layout",
      "  policy-toc-nav (left sticky)",
      "  page-content-main (+ optional editorial-separator)",
      "  policy-sibling-nav (right sticky)",
      "Footer"
    ],
    "note": "Kreis theme.json pages[] still lacks Privacy/Terms/Cookie CUSTOM pages; Main 3-col supersedes prior single-stack recipe"
  },
  "slugs": {
    "privacy-policy": {
      "en": "Privacy Policy",
      "tr": "Gizlilik Politikası",
      "de": "Datenschutz"
    },
    "terms-and-conditions": {
      "en": "Terms & Conditions",
      "tr": "Şartlar ve Koşullar",
      "de": "AGB"
    },
    "cookie": {
      "en": "Cookie Policy",
      "tr": "Çerez Politikası",
      "de": "Cookie-Richtlinie",
      "note": "Kreis Footer.legalLinks only; theme typo Cookie Concent"
    }
  },
  "sections": [
    {
      "order": 1,
      "schemaId": "navigation-header-mega",
      "scope": "global",
      "required": true,
      "kreisComponent": "Header"
