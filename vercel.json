{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{sections,observations,taxonomy,candidates,viewer,apps}/**",
      "excludeFiles": "{evidence/**,public/evidence/**}",
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/evidence/:path*",
      "destination": "https://cdn.jsdelivr.net/gh/mattiasadem/qante@main/evidence/:path*"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
