{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{sections,observations,taxonomy,candidates,viewer}/**",
      "excludeFiles": "{evidence/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
