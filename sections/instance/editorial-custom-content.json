{
  "id": "editorial-custom-content",
  "kategori": "editorial",
  "varyant": "custom-content",
  "scope": "instance",
  "amac": "Serbest blok düzeniyle editoryal/ürün karışık içerik alanı",
  "slots": {
    "bloklar": {
      "tip": "array",
      "min": 1,
      "max": 12,
      "item": {
        "tur": {
          "tip": "text",
          "maxLen": 30,
          "zorunlu": false
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": false
        },
        "baslik": {
          "tip": "text",
          "maxLen": 80,
          "zorunlu": false
        },
        "metin": {
          "tip": "text",
          "maxLen": 200,
          "zorunlu": false
        },
        "link": {
          "tip": "link",
          "zorunlu": false
        },
        "urun": {
          "tip": "ref",
          "zorunlu": false,
          "hedef": "product"
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "layout": "overlay|split|lookbook",
    "kolon": [
      2,
      3,
      4
    ],
    "hizalama": "left|center",
    "hotspotGoster": true,
    "rozetGoster": true
  },
  "dataBindings": [],
  "actions": [
    "navigate",
    "emit:product.quickView"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-quick-view"
  ],
  "responsive": "Overlay ve lookbook mobilde 1 kart + peek. Split bannerlar tek kolon."
}
