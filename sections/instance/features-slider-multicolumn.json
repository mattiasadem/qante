{
  "id": "features-slider-multicolumn",
  "kategori": "features-benefits",
  "varyant": "slider-multicolumn",
  "scope": "instance",
  "amac": "Özellik/detay anlatımını slider + çok kolonlu kartlarla göstermek",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 80,
      "zorunlu": true
    },
    "altBaslik": {
      "tip": "text",
      "maxLen": 160,
      "zorunlu": false
    },
    "items": {
      "tip": "array",
      "min": 2,
      "max": 12,
      "item": {
        "baslik": {
          "tip": "text",
          "maxLen": 60,
          "zorunlu": true
        },
        "metin": {
          "tip": "text",
          "maxLen": 200,
          "zorunlu": false
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": false
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "gorselKonumu": "left|right",
    "hizalama": "left|center",
    "autoplay": true,
    "okGoster": true,
    "noktaGoster": true
  },
  "dataBindings": [],
  "actions": [
    "navigate",
    "emit:slide.change"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "responsive": "768'de slider üste, kartlar alta. 375'te kartlar iki'li.",
  "_knobNote": "Sol slider + sağ 2×2 kart birlikte — grid|slider seçimi yok. 3–4 kolon sayılmadı."
}
