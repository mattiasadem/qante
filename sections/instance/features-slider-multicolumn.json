        "gorsel": { "tip": "image", "zorunlu": false }
      }
    }
  },
  "styleKnobs": {
    "kolon": [2, 3, 4],
    "slider": true
  },
  "dataBindings": [],
  "actions": ["navigate"],
  "hookNoktalari": ["mount:section.after"],
  "bagimliliklar": [],
  "responsive": "Mobilde tek kart swipe"
