{
  "id": "product-info-main",
  "kategori": "product-info",
  "varyant": "main",
  "scope": "instance",
  "amac": "PDP ana blok: galeri, başlık, fiyat, varyant, sepete ekle",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 100,
      "zorunlu": true
    },
    "icerik": {
      "tip": "richtext",
      "zorunlu": false
    },
    "galeri": {
      "tip": "array",
      "item": {
        "gorsel": {
          "tip": "image",
          "zorunlu": true
        }
      },
      "zorunlu": true,
      "min": 1,
      "max": 12
    }
  },
  "styleKnobs": {
    "gorselKonumu": "left|right",
    "varyantGosterim": "swatch|dropdown",
    "miktarGosterim": "stepper|dropdown",
    "rozetGoster": true
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add",
    "emit:variant.change",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:gallery.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer"
  ],
  "responsive": "Mobilde galeri üstte (ana görsel + thumb alta), buy box alta. 768 hâlâ 2×2 sol + buy box sağ."
}
