{
  "id": "comparison-quick-table",
  "kategori": "comparison",
  "varyant": "quick-table",
  "scope": "instance",
  "amac": "Ürünleri özellik satırlarıyla yan yana hızlı karşılaştırma",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60,
      "zorunlu": false
    },
    "urunler": {
      "tip": "array",
      "min": 2,
      "max": 5,
      "item": {
        "urun": {
          "tip": "ref",
          "hedef": "product",
          "zorunlu": true
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "layout": "stacked|split",
    "kolon": [
      2,
      3,
      5
    ],
    "hizalama": "left|center",
    "ikonGoster": true
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual",
        "limit": 4
      }
    }
  ],
  "actions": [
    "navigate",
    "emit:product.quickView"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-quick-view"
  ],
  "responsive": "Mobilde tablo yatay kayar; split intro üste düşer."
}
