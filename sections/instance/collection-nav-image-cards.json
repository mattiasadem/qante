{
  "id": "collection-nav-image-cards",
  "kategori": "collection-nav",
  "varyant": "image-cards",
  "scope": "instance",
  "amac": "Koleksiyon veya kategori keşfini büyük görsel kartlarla yönlendirmek",
  "slots": {
    "baslik": { "tip": "text", "maxLen": 80, "zorunlu": false },
    "altBaslik": { "tip": "text", "maxLen": 160, "zorunlu": false },
    "items": {
      "tip": "array",
      "min": 2,
      "max": 8,
      "item": {
        "gorsel": { "tip": "image" },
        "baslik": { "tip": "text", "maxLen": 40 },
        "link": { "tip": "link" }
      }
    }
  },
  "styleKnobs": {
    "kolon": [2, 3, 4],
    "metinKonumu": "overlay|below"
  },
  "dataBindings": [
    {
      "name": "koleksiyonlar",
      "source": "DataSource.collectionList",
      "params": { "kaynak": "manual|menu", "limit": 8 },
      "zorunlu": false
    }
  ],
  "actions": ["navigate"],
  "hookNoktalari": ["mount:section.after"],
  "bagimliliklar": [],
  "responsive": "Mobilde 1–2 kart"
}
