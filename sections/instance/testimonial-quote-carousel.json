{
  "id": "testimonial-quote-carousel",
  "kategori": "testimonial-ugc",
  "varyant": "quote-carousel",
  "scope": "instance",
  "amac": "Müşteri alıntılarıyla sosyal kanıt göstermek; güven ve yaşam tarzı doğrulaması",
  "slots": {
    "baslik": { "tip": "text", "maxLen": 80, "zorunlu": false },
    "items": {
      "tip": "array",
      "min": 1,
      "max": 12,
      "item": {
        "alinti": { "tip": "text", "maxLen": 280 },
        "ad": { "tip": "text", "maxLen": 60 },
        "konum": { "tip": "text", "maxLen": 80, "zorunlu": false },
        "avatar": { "tip": "image", "zorunlu": false },
        "puan": { "tip": "number", "zorunlu": false }
      }
    }
  },
  "styleKnobs": {
    "layout": "carousel|grid",
    "kolon": [1, 2, 3],
    "hizalama": "left|center"
  },
  "dataBindings": [],
  "actions": ["emit:carousel.next", "emit:carousel.prev"],
  "hookNoktalari": ["mount:section.before", "mount:section.after"],
  "bagimliliklar": [],
  "responsive": "Mobilde tek kart / swipe; desktop’ta 2–3 kart veya carousel"
}
