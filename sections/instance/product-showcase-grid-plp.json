{
  "id": "product-showcase-grid-plp",
  "kategori": "product-showcase",
  "varyant": "grid-plp",
  "scope": "instance",
  "amac": "Koleksiyon ürünlerini filtre/sort ile ızgara olarak listelemek",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60,
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "layout": "grid|list",
    "kolon": [
      2,
      4
    ],
    "filtreGoster": true,
    "sortGoster": true,
    "rozetGoster": true,
    "hizliEkleGoster": true
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "collection",
        "limit": 48
      }
    }
  ],
  "actions": [
    "emit:product.quickView",
    "emit:cart.add",
    "navigate",
    "emit:filter.change"
  ],
  "hookNoktalari": [
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "global-quick-view"
  ],
  "responsive": "Mobil 2 kolon; filtre drawer. Sort masaüstü barda."
}
