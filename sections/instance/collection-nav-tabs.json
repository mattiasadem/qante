{
  "id": "collection-nav-tabs",
  "kategori": "collection-nav",
  "varyant": "tabs",
  "scope": "instance",
  "amac": "Sekmeli koleksiyon vitrini: büyük görsel + metin + CTA, sekme ile koleksiyon değiştirme",
  "slots": {
    "sekmeler": {
      "tip": "array",
      "min": 1,
      "max": 8,
      "item": {
        "etiket": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        },
        "baslik": {
          "tip": "text",
          "maxLen": 80,
          "zorunlu": false
        },
        "metin": {
          "tip": "text",
          "maxLen": 220,
          "zorunlu": false
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": true
        },
        "cta": {
          "tip": "button",
          "zorunlu": false
        },
        "koleksiyon": {
          "tip": "link",
          "zorunlu": false
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "gorselKonumu": "left|right",
    "tabPozisyon": "top|side",
    "hizalama": "left|center"
  },
  "dataBindings": [
    {
      "name": "koleksiyonlar",
      "source": "DataSource.collectionList",
      "params": {
        "kaynak": "manual",
        "limit": 8
      }
    }
  ],
  "actions": [
    "navigate",
    "emit:tab.change"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "responsive": "Mobilde medya üste iner; dikey koleksiyon listesi üstte kalır.",
  "_knobNote": "Default/Nexvo: görsel sağ + yan liste. media-background ve yatay top-tab yok. 3 knob."
}
