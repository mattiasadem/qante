{
  "id": "collection-nav-tabs",
  "kategori": "collection-nav",
  "varyant": "tabs",
  "scope": "instance",
  "amac": "Sekmeli koleksiyon vitrini: büyük görsel + metin + CTA, sekme ile koleksiyon değiştirme",
  "slots": {
    "sekmeler": {
      "tip": "array",
      "min": 1,
      "max": 8,
      "item": {
        "etiket": { "tip": "text", "maxLen": 40 },
        "baslik": { "tip": "text", "maxLen": 80, "zorunlu": false },
        "aciklama": { "tip": "text", "maxLen": 220, "zorunlu": false },
        "gorsel": { "tip": "image" },
        "cta": { "tip": "button" },
        "koleksiyon": { "tip": "link" }
      }
    }
  },
  "styleKnobs": {
    "layout": "media-left|media-right|media-background",
    "tabPozisyon": "top|side"
  },
  "dataBindings": [
    {
      "name": "koleksiyonlar",
      "source": "DataSource.collectionList",
      "params": { "kaynak": "manual", "limit": 8 }
    }
  ],
  "actions": ["navigate", "emit:tab.change"],
  "hookNoktalari": ["mount:section.after"],
  "bagimliliklar": [],
  "responsive": "Mobilde sekmeler yatay scroll; medya üstte"
}
