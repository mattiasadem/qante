{
  "id": "media-lookbook-slider",
  "kategori": "media",
  "varyant": "lookbook-slider",
  "scope": "instance",
  "amac": "Mekan/look görselleri üzerinden ürün hotspot’larıyla lookbook vitrini",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 80,
      "zorunlu": true
    },
    "slaytlar": {
      "tip": "array",
      "min": 1,
      "max": 10,
      "item": {
        "gorsel": {
          "tip": "image",
          "zorunlu": true
        },
        "etiket": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        },
        "urunler": {
          "tip": "array",
          "max": 8,
          "item": {
            "urun": {
              "tip": "ref",
              "hedef": "product",
              "zorunlu": true
            },
            "hotspot": {
              "tip": "object",
              "zorunlu": false,
              "alanlar": {
                "x": {
                  "tip": "number",
                  "zorunlu": true
                },
                "y": {
                  "tip": "number",
                  "zorunlu": true
                }
              }
            }
          },
          "zorunlu": true,
          "min": 1
        },
        "cta": {
          "tip": "button",
          "zorunlu": false
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "layout": "peek-slider|split",
    "hizalama": "left|center",
    "hotspotGoster": true,
    "okGoster": true,
    "noktaGoster": true
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual",
        "limit": 8
      }
    }
  ],
  "actions": [
    "navigate",
    "emit:product.quickView"
  ],
  "hookNoktalari": [
    "mount:section.after",
    "mount:hotspot.after"
  ],
  "bagimliliklar": [
    "global-quick-view"
  ],
  "responsive": "1440 yanında ürün kartı veya peek slider. 375/768 istif: look görseli üstte, kart altta.",
  "_knobNote": "PNG peek-slider + hotspot chip + ok. stacked ikinci iskelet yok."
}
