{
  "id": "commerce-tools-products-bundle",
  "kategori": "product-showcase",
  "varyant": "products-bundle",
  "scope": "instance",
  "amac": "Birden fazla ürünü paket/indirimle birlikte seçtirip sepete eklemek (bundle builder)",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 80,
      "zorunlu": true
    },
    "altBaslik": {
      "tip": "text",
      "maxLen": 160,
      "zorunlu": false
    },
    "indirimEtiketi": {
      "tip": "text",
      "maxLen": 40,
      "zorunlu": false
    },
    "cta": {
      "tip": "button",
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "layout": "grid|slider|split",
    "kolon": [
      2,
      3,
      4
    ],
    "hotspotGoster": true,
    "kategoriTabGoster": true,
    "okGoster": true
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual|bundle",
        "limit": 6
      }
    }
  ],
  "actions": [
    "emit:cart.add",
    "emit:bundle.change",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:bundle.belowItems",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer"
  ],
  "responsive": "Mobilde 2 kolon veya stack; split dikeyleşir (görsel üstte).",
  "_taxonomyNote": "Aday kategori commerce-tools — onaylanınca kategori alanı güncellenir (candidates/commerce-tools.md)"
}
