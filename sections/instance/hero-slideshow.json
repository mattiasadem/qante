{
  "id": "hero-slideshow",
  "kategori": "hero",
  "varyant": "slideshow",
  "scope": "instance",
  "amac": "Ana vitrinde tam genişlik slaytlarla koleksiyon/kampanya hikâyesi anlatmak ve CTA ile yönlendirmek",
  "slots": {
    "slaytlar": {
      "tip": "array",
      "min": 1,
      "max": 8,
      "item": {
        "ustEtiket": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        },
        "baslik": {
          "tip": "text",
          "maxLen": 60,
          "zorunlu": true
        },
        "altBaslik": {
          "tip": "text",
          "maxLen": 160,
          "zorunlu": false
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": true
        },
        "cta": {
          "tip": "button",
          "zorunlu": false
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "hizalama": "center|left|right",
    "dikeyHizalama": "top|center|bottom",
    "yukseklik": "compact|regular|tall",
    "autoplay": true,
    "okGoster": true,
    "noktaGoster": true
  },
  "dataBindings": [],
  "actions": [
    "navigate",
    "emit:slide.change"
  ],
  "hookNoktalari": [
    "mount:section.before",
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "responsive": "Mobilde tam genişlik; oklar küçülür veya swipe; metin boyutu düşer"
}
