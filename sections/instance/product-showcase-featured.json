{
  "id": "product-showcase-featured",
  "kategori": "product-showcase",
  "varyant": "featured",
  "scope": "instance",
  "amac": "Tek öne çıkan ürünü galeri + satın alma kutusuyla vitrine koymak",
  "slots": {
    "ustEtiket": {
      "tip": "text",
      "maxLen": 40,
      "zorunlu": false
    },
    "baslik": {
      "tip": "text",
      "maxLen": 80,
      "zorunlu": true
    },
    "metin": {
      "tip": "text",
      "maxLen": 200,
      "zorunlu": false
    },
    "cta": {
      "tip": "button",
      "zorunlu": false
    },
    "urun": {
      "tip": "ref",
      "hedef": "product",
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "gorselKonumu": "left|right",
    "varyantGosterim": "swatch|dropdown",
    "miktarGosterim": "stepper|dropdown",
    "noktaGoster": true,
    "rozetGoster": true
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add",
    "emit:variant.change",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:gallery.after",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer"
  ],
  "responsive": "1440 görsel bir yanda, metin+CTA veya buy box diğer yanda. 375 istif."
}
