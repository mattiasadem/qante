{
  "id": "collection-nav-grid",
  "kategori": "collection-nav",
  "varyant": "grid",
  "scope": "instance",
  "amac": "Koleksiyonları ızgara kartlarıyla kategori keşfine açmak",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60,
      "zorunlu": false
    },
    "altBaslik": {
      "tip": "text",
      "maxLen": 120,
      "zorunlu": false
    },
    "items": {
      "tip": "array",
      "min": 2,
      "max": 16,
      "item": {
        "ad": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": true
        },
        "link": {
          "tip": "link",
          "zorunlu": false
        },
        "urunSayisi": {
          "tip": "number",
          "zorunlu": false
        }
      },
      "zorunlu": true
    },
    "cta": {
      "tip": "button",
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "kolon": [3, 4, 5, 6],
    "kartStili": "image-overlay|image-below",
    "oran": "1:1|4:5|16:9",
    "hizalama": "left|center"
  },
  "dataBindings": [
    {
      "name": "koleksiyonlar",
      "source": "DataSource.collectionList",
      "params": {
        "kaynak": "manual|all|parent",
        "limit": 12
      }
    }
  ],
  "actions": [
    "navigate"
  ],
  "hookNoktalari": [
    "mount:section.before",
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "responsive": "1440'ta 6 kolon daire ızgara; 375'te 3 kolon. Başlık solda."
}
