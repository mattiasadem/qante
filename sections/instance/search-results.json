{
  "id": "search-results",
  "kategori": "product-showcase",
  "varyant": "search-results",
  "scope": "instance",
  "amac": "Arama sonuçlarını ürün/grid ve filtrelerle göstermek",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60,
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "layout": "grid|list",
    "kolon": [
      2,
      4
    ],
    "filtreGoster": true,
    "sortGoster": true,
    "rozetGoster": true,
    "hizliEkleGoster": true
  },
  "dataBindings": [
    {
      "name": "sonuclar",
      "source": "DataSource.searchResults"
    }
  ],
  "actions": [
    "navigate",
    "emit:product.quickView"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-quick-view"
  ],
  "responsive": "1440 dört kolon + sol filtre. 375 iki kolon; filtre butona iner. Sayfalama var, infinite scroll yok."
}
