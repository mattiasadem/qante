{
  "id": "product-showcase-tabs",
  "kategori": "product-showcase",
  "varyant": "tabs",
  "scope": "instance",
  "amac": "Birden fazla ürün listesini sekmelerle aynı vitrinde göstermek",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 80,
      "zorunlu": false
    },
    "sekmeler": {
      "tip": "array",
      "min": 2,
      "max": 6,
      "item": {
        "etiket": {
          "tip": "text",
          "maxLen": 30,
          "zorunlu": false
        },
        "urunKaynak": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        }
      },
      "zorunlu": true
    }
  },
  "styleKnobs": {
    "layout": "split|stacked",
    "tabPozisyon": "side|top",
    "kategoriTabGoster": true,
    "kolon": [
      2,
      4
    ]
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "collection|manual",
        "limit": 8
      }
    }
  ],
  "actions": [
    "emit:tab.change",
    "emit:product.quickView",
    "emit:cart.add",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "global-quick-view"
  ],
  "responsive": "375 kopya + yatay sekme + 1 kart peek. 1440 yan sekme ve sağda iki kart.",
  "_knobNote": "Pillar split+yan+2 kart. Allure/Vogue stacked+üst+4 ürün. 375 stacked otomatik."
}
