{
  "id": "product-showcase-tabs",
  "kategori": "product-showcase",
  "varyant": "tabs",
  "scope": "instance",
  "amac": "Birden fazla ürün listesini sekmelerle aynı vitrinde göstermek",
  "slots": {
    "baslik": { "tip": "text", "maxLen": 80, "zorunlu": false },
    "sekmeler": {
      "tip": "array",
      "min": 2,
      "max": 6,
      "item": {
        "etiket": { "tip": "text", "maxLen": 30 },
        "urunKaynak": { "tip": "text", "maxLen": 40 }
      }
    }
  },
  "styleKnobs": {
    "kolon": [2, 3, 4],
    "layout": "grid|slider"
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": { "kaynak": "collection|manual", "limit": 8 }
    }
  ],
  "actions": ["emit:tab.change", "emit:product.quickView", "emit:cart.add", "navigate"],
  "hookNoktalari": ["mount:productCard.badge", "mount:section.after"],
  "bagimliliklar": [],
  "responsive": "Mobilde sekmeler yatay scroll; grid 2 kolon"
}
