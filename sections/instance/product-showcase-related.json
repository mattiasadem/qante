{
  "id": "product-showcase-related",
  "kategori": "product-showcase",
  "varyant": "related",
  "scope": "instance",
  "amac": "İlgili / önerilen ürünleri vitrine çıkarmak",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60
    },
    "altBaslik": {
      "tip": "text",
      "maxLen": 120,
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "layout": "slider|grid",
    "kolon": [
      2,
      3,
      4
    ]
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "related|manual",
        "limit": 8
      }
    }
  ],
  "actions": [
    "emit:product.quickView",
    "emit:cart.add",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "responsive": "Mobil slider"
}
