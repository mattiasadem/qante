{
  "id": "product-showcase-related",
  "kategori": "product-showcase",
  "varyant": "related",
  "scope": "instance",
  "amac": "İlgili / önerilen ürünleri vitrine çıkarmak",
  "slots": {
    "baslik": {
      "tip": "text",
      "maxLen": 60,
      "zorunlu": true
    },
    "altBaslik": {
      "tip": "text",
      "maxLen": 120,
      "zorunlu": false
    }
  },
  "styleKnobs": {
    "kolon": [3, 4, 5],
    "hizalama": "left|center",
    "rozetGoster": true,
    "hizliEkleGoster": true
  },
  "dataBindings": [
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "related|manual",
        "limit": 8
      }
    }
  ],
  "actions": [
    "emit:product.quickView",
    "emit:cart.add",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "global-quick-view"
  ],
  "responsive": "1440 beş kartlık satır (ok yok). 375 peek slider + progress bar.",
  "_knobNote": "Masaüstü ızgara (Impulse 3 / Allure 4 / Hyper 5). 375 peek slider otomatik — layout grid|slider yok."
}
