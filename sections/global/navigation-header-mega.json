{
  "id": "navigation-header-mega",
  "kategori": "navigation",
  "varyant": "header-mega",
  "scope": "global",
  "amac": "Ana gezinme; çok koleksiyonlu mağazada menüyü merchandising alanına çevirir",
  "slots": {
    "logo": {
      "tip": "image",
      "zorunlu": true
    },
    "menu": {
      "tip": "ref",
      "hedef": "menu",
      "zorunlu": true
    },
    "megaPaneller": {
      "tip": "array",
      "max": 6,
      "item": {
        "kolonlar": {
          "tip": "array",
          "zorunlu": true,
          "min": 1,
          "max": 6,
          "item": {
            "baslik": {
              "tip": "text",
              "zorunlu": false,
              "maxLen": 40
            },
            "gorsel": {
              "tip": "image",
              "zorunlu": false
            },
            "linkler": {
              "tip": "array",
              "zorunlu": true,
              "min": 1,
              "max": 12,
              "item": {
                "etiket": {
                  "tip": "text",
                  "zorunlu": true,
                  "maxLen": 40
                },
                "link": {
                  "tip": "link",
                  "zorunlu": true
                }
              }
            }
          }
        },
        "gorsel": {
          "tip": "image",
          "zorunlu": false
        },
        "promoKarti": {
          "tip": "ref",
          "zorunlu": false,
          "hedef": "promo"
        }
      },
      "zorunlu": true,
      "min": 1
    }
  },
  "styleKnobs": {
    "sticky": true,
    "yukseklik": "compact|regular",
    "dilGosterim": "full_label|short_code|icon_only|icon_with_short_code"
  },
  "dataBindings": [
    {
      "name": "menu",
      "source": "DataSource.navigation"
    }
  ],
  "actions": [
    "emit:search.open",
    "emit:cart.open",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:header.before",
    "mount:header.utility",
    "mount:header.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "global-predictive-search"
  ],
  "responsive": "Mobilde hamburger + tam ekran menü; mega paneller akordeon olur"
}
