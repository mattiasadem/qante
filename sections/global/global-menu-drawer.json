{
  "id": "global-menu-drawer",
  "kategori": "navigation",
  "varyant": "menu-drawer",
  "scope": "global",
  "amac": "Mobil/yan menü drawer ile navigasyon",
  "slots": {
    "menuler": {
      "tip": "array",
      "item": {
        "etiket": {
          "tip": "text",
          "maxLen": 40,
          "zorunlu": false
        },
        "link": {
          "tip": "link",
          "zorunlu": false
        }
      },
      "zorunlu": true,
      "min": 1,
      "max": 12
    }
  },
  "styleKnobs": {
    "side": "left|right"
  },
  "dataBindings": [
    {
      "name": "menu",
      "source": "DataSource.navigation"
    }
  ],
  "actions": [
    "navigate",
    "emit:drawer.close"
  ],
  "hookNoktalari": [
    "mount:menu.after"
  ],
  "bagimliliklar": [],
  "responsive": "Özellikle mobilde birincil nav"
}
