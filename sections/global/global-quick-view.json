{
  "id": "global-quick-view",
  "kategori": "product-info",
  "varyant": "quick-view",
  "scope": "global",
  "amac": "Ürünü sayfadan çıkmadan hızlı görüntüle / sepete ekle",
  "slots": {
    "cta": {
      "tip": "button",
      "zorunlu": false,
      "not": "Ürün detayına git — ürün alanları dataBinding"
    }
  },
  "styleKnobs": {
    "layout": "modal|drawer"
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add",
    "navigate",
    "emit:modal.close"
  ],
  "hookNoktalari": [
    "mount:quickView.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer"
  ],
  "responsive": "Mobil tam ekran modal"
}
