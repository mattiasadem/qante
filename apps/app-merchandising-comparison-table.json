    "shopify": [
      "app-block"
    ],
    "ikas": [
      "storefront-js-script",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "VIEW_CATEGORY"
  ],
  "ikasSayfa": [
