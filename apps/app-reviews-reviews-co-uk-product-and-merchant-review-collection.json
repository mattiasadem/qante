{
  "id": "app-reviews-reviews-co-uk-product-and-merchant-review-collection",
  "kategori": "reviews",
  "varyant": "reviews-co-uk",
  "scope": "in-flow",
  "amac": "Ürün ve mağaza yorumlarını toplayıp PDP ve mağaza sayfasında gösterir.",
  "sorun": "Üçüncü taraf review toplama tema ile gelmez; Reviews.co.uk hem ürün hem merchant skoru sunar.",
  "link": "https://apps.shopify.com/reviews-co-uk-product-and-merchant-review-collection",
  "yuzey": [
    "review_stars",
    "review_widget",
    "trust_badge"
  ],
  "entegrasyon": {
