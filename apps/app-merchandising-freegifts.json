{
  "id": "app-merchandising-freegifts",
  "kategori": "merchandising",
  "varyant": "freegifts",
  "scope": "in-flow",
  "amac": "BOGO ve hediye ürün kuralları ile sepete ek ürün teşviki sunar.",
  "sorun": "Hediye ve BOGO kampanyaları tema ile koşullu gösterilmez; BOGOS kural motoru ekler.",
  "link": "https://apps.shopify.com/freegifts",
  "yuzey": [
    "product_recs"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "ADD_TO_CART",
    "VIEW_CART"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "hediyeKurali": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80
    },
    "minimumSepet": {
      "tip": "number",
      "zorunlu": false
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "sepet",
      "source": "DataSource.cart"
    },
    {
      "name": "hediyeUrun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:buyBox.after"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "yok",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
