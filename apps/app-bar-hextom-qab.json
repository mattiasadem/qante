{
  "id": "app-bar-hextom-qab",
  "kategori": "bar",
  "varyant": "hextom-qab",
  "scope": "overlay",
  "amac": "Üst duyuru şeridi ile kampanya, kargo veya acil mesajları tüm sayfalarda gösterir.",
  "sorun": "Tema duyuru alanı sınırlı hedefleme sunar; kampanya ve kargo mesajları tüm sayfalarda tutarlı görünmez.",
  "link": "https://apps.shopify.com/quick-announcement-bar-always-keep-your-customers-informed",
  "yuzey": [
    "announcement_bar"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed"
    ],
    "ikas": [
      "storefront-script"
    ]
  },
  "ikasTur": "yok",
  "ikasOlaylar": [
    "PAGE_VIEW"
  ],
  "ikasSayfa": [
    "INDEX",
    "PRODUCT",
    "CATEGORY",
    "CART"
  ],
  "ayarlar": {
    "mesaj": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 200
    },
    "link": {
      "tip": "link",
      "zorunlu": false
    },
    "konum": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 20
    },
    "cihazHedefi": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 20
    },
    "zamanlama": {
      "tip": "object",
      "zorunlu": false,
      "alanlar": {
        "baslangic": {
          "tip": "datetime",
          "zorunlu": false
        },
        "bitis": {
          "tip": "datetime",
          "zorunlu": false
        }
      }
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:announcement.before"
  ],
  "bagimliliklar": [
    "promo-announcement-bar"
  ],
  "ikasKarsilik": "yok"
}
