{
  "id": "app-reviews-ryviu",
  "kategori": "reviews",
  "varyant": "ryviu",
  "scope": "in-flow",
  "amac": "Satış sonrası fotoğraf/video yorum toplayıp markaya uygun widget’larla vitrinde göstermek.",
  "sorun": "Listing Ryviu: Loyalty & Reviews App. Bu kayıt yalnızca reviews yüzeyi (yıldız/widget). Loyalty launcher yazılmadı. ikas app-block yok.",
  "link": "https://apps.shopify.com/ryviu",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "app-block",
      "script-tag"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "PAGE_VIEW",
    "COMPLETE_CHECKOUT"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "INDEX",
    "CATEGORY"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "write_products",
    "read_orders",
    "read_customers"
  ],
  "ikasAksiyon": [
    {
      "yer": "product-edit",
      "tip": "iframe"
    }
  ],
  "ikasWebhook": [
    "store/order/created",
    "store/product/updated"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "widgetBaslik": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 80
    },
    "yildizGoster": {
      "tip": "boolean",
      "zorunlu": false
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:review.filter",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section yıldız + yorum listesi + carousel. Loyalty yüzeyi bu dosyada yok. Resmi ikas listing yok.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
