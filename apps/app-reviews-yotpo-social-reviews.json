{
  "id": "app-reviews-yotpo-social-reviews",
  "kategori": "reviews",
  "varyant": "yotpo-social-reviews",
  "scope": "in-flow",
  "amac": "Fotoğraflı/videolu ürün yorumları ve puanları toplayıp vitrinde sosyal kanıt göstermek.",
  "sorun": "Yotpo widget'ları Shopify app block + embed ile yerleşir; ikas'ta app-block yok. Karşılık storefront-js-script ve Studio section. Google Seller Ratings senkronu ayrıca webhook/sipariş olayı ister.",
  "link": "https://apps.shopify.com/yotpo-social-reviews",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel",
    "ugc_gallery"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "PAGE_VIEW",
    "COMPLETE_CHECKOUT"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "INDEX",
    "CATEGORY"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "write_products",
    "read_orders",
    "read_customers"
  ],
  "ikasAksiyon": [
    {
      "yer": "product-edit",
      "tip": "iframe"
    }
  ],
  "ikasWebhook": [
    "store/order/created",
    "store/product/updated"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "widgetBaslik": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 80
    },
    "yildizGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "filtreGoster": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "Listingde advertised Smart Filters"
    },
    "ugcGaleriGoster": {
      "tip": "boolean",
      "zorunlu": false
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:review.filter",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section yıldız + widget + UGC galeri; sipariş webhook'u ile otomatik talep; harici Yotpo hesabı publicApiKey ile bağlanır.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
