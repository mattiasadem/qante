{
  "id": "app-reviews-okendo-reviews",
  "kategori": "reviews",
  "varyant": "okendo-reviews",
  "scope": "in-flow",
  "amac": "UGC, yıldız ve yorum carousel ile marka güvenini PDP'de gösterir.",
  "sorun": "Premium markalar için yorum ve UGC vitrinde eksik kalır; Okendo zengin widget seti sunar.",
  "link": "https://apps.shopify.com/okendo-reviews",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel",
    "ugc_gallery"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW"
  ],
  "ikasSayfa": [
    "PRODUCT"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "yildizOzetiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "ugcGaleriGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "Lehte",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
