{
  "id": "app-merchandising-skio",
  "kategori": "merchandising",
  "varyant": "skio",
  "scope": "in-flow",
  "amac": "Abonelik planı, build-a-box ve iptal akışını vitrin / hesap yüzeyinde yöneterek tekrarlayan geliri büyütmek.",
  "sorun": "Listing Skio, a Recharge Company: no-code portal, build-a-box, çok adımlı iptal. ikas’ta checkout-extension yok; karşılık studio-section kutu/plan yüzeyi.",
  "link": "https://apps.shopify.com/skio",
  "yuzey": [
    "product_recs"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "checkout-extension"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "ADD_TO_CART",
    "CUSTOMER_LOGIN",
    "COMPLETE_CHECKOUT"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART",
    "ACCOUNT"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders",
    "read_customers",
    "write_customers"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [
    "store/order/created",
    "store/customer/updated"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "baslik": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 80
    },
    "kutuKurucuAcik": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "Listing Build-a-Box vaat ediyor"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "musteri",
      "source": "DataSource.customer"
    }
  ],
  "actions": [
    "emit:cart.add",
    "navigate"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section plan / kutu seçici. Portal ve checkout Skio akışı ikas checkout-extension ile birebir değil.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
