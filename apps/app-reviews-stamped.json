{
  "id": "app-reviews-stamped",
  "kategori": "reviews",
  "varyant": "stamped",
  "scope": "in-flow",
  "amac": "Yorum ve puanları vitrine yerleştirir; isteğe bağlı sadakat launcher ile birleştirilebilir.",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel",
    "ugc_gallery",
    "loyalty_launcher"
  ],
  "entegrasyon": [
    "app-block",
    "app-embed"
  ],
  "dataBindings": [
