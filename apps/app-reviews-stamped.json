  "ayarlar": {
    "yildizOzetiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "yorumListesiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "sadakatLauncherGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "npsAnketiGoster": {
      "tip": "boolean",
      "zorunlu": false
    }
  }
