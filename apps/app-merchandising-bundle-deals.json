{
  "id": "app-merchandising-bundle-deals",
  "kategori": "merchandising",
  "varyant": "bundle-deals",
  "scope": "in-flow",
  "amac": "Ürün sayfasında paket ve bundle teklifleri ile AOV artırır.",
  "sorun": "Tek ürün satışı AOV'u sınırlar; Bundle Deals birlikte al kampanyası sunar.",
  "link": "https://apps.shopify.com/bundle-deals",
  "yuzey": [
    "product_recs"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "ADD_TO_CART"
  ],
  "ikasSayfa": [
    "PRODUCT"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "bundleGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "indirimYuzdesi": {
      "tip": "number",
      "zorunlu": false
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "paketUrunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual",
        "limit": 4
      }
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:buyBox.after"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "yok",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
