{
  "id": "app-merchandising-zipify-oneclickupsell",
  "kategori": "merchandising",
  "varyant": "zipify-oneclickupsell",
  "scope": "in-flow",
  "amac": "Ödeme öncesi ve sonrası tek tık upsell hunileriyle ortalama sepet değerini artırmak.",
  "sorun": "Listing One Click Upsell Zipify OCU: pre & post-purchase 1-click funnels. ikas’ta checkout-extension yok; karşılık studio-section product_recs, checkout birebir taşınmaz.",
  "link": "https://apps.shopify.com/zipify-oneclickupsell",
  "yuzey": [
    "product_recs"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "checkout-extension"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "BEGIN_CHECKOUT",
    "COMPLETE_CHECKOUT",
    "PAGE_VIEW",
    "ADD_TO_CART"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART",
    "CHECKOUT"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [
    "store/order/created"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "baslik": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 80,
      "not": "Upsell teklif başlığı"
    },
    "limit": {
      "tip": "number",
      "zorunlu": false
    }
  },
  "dataBindings": [
    {
      "name": "oneriler",
      "source": "DataSource.productList"
    },
    {
      "name": "sepet",
      "source": "DataSource.cart"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:section.after"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section product_recs (pre/post-purchase teklif). Shopify checkout-extension ikas’a taşınmaz.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
