  "ayarlar": {
    "baslik": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80
    },
    "indirimKodu": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40
    },
    "carkAktif": {
      "tip": "boolean",
      "zorunlu": false
    },
    "duyuruSeridiGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "gosterimGecikmesi": {
      "tip": "number",
      "zorunlu": false
    }
  }
}
