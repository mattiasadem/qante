{
  "id": "app-reviews-yotpo",
  "kategori": "reviews",
  "varyant": "yotpo",
  "scope": "in-flow",
  "amac": "Yorum, puan ve UGC içeriğini ölçeklenebilir şekilde ürün sayfalarına ve koleksiyonlara bağlar.",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel",
    "ugc_gallery",
    "review_floating_tab"
  ],
  "entegrasyon": [
    "app-block",
    "app-embed"
  ],
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual",
        "limit": 12
      }
    }
  ],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "Lehte",
  "link": "https://apps.shopify.com/yotpo-social-reviews",
  "sorun": "Yorum, puan ve UGC ayrı sistemlerde kalınca vitrin güven kanıtı tutarsız olur; Yotpo bunu tek panelde toplar.",
  "ayarlar": {
    "yildizOzetiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "yorumWidgetGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "ugcGaleriGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "syndicationAktif": {
      "tip": "boolean",
      "zorunlu": false
    },
    "minimumPuan": {
      "tip": "number",
      "zorunlu": false
    }
  }
}
