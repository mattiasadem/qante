{
  "id": "app-capture-mailchimp",
  "kategori": "capture",
  "varyant": "mailchimp",
  "scope": "overlay",
  "amac": "Mailchimp listesine abone toplamak için sınırlı onsite popup ve gömülü formlar sağlar.",
  "sorun": "Mailchimp listesi büyümesi tema formlarına bağlı kalınca ziyaretçi çoğu sayfada hiç yakalanmaz.",
  "link": "https://apps.shopify.com/mailchimp",
  "yuzey": [
    "popup_modal",
    "embedded_form"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "yok",
  "ikasOlaylar": [
    "PAGE_VIEW",
    "CUSTOMER_REGISTER",
    "CONTACT_FORM"
  ],
  "ikasSayfa": [
    "INDEX",
    "CUSTOM"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "storefront-script",
  "ikasKapsam": [
    "read_customers"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "baslik": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80
    },
    "listeId": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 40
    },
    "popupAktif": {
      "tip": "boolean",
      "zorunlu": true
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "musteri",
      "source": "DataSource.customer"
    }
  ],
  "actions": [
    "emit:newsletter.subscribe"
  ],
  "hookNoktalari": [
    "mount:newsletter.before"
  ],
  "bagimliliklar": [
    "lead-capture-newsletter-band"
  ],
  "ikasKarsilik": "yok",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
