{
  "id": "app-merchandising-aftersell",
  "kategori": "merchandising",
  "varyant": "aftersell",
  "scope": "checkout",
  "amac": "Sipariş sonrası upsell teklifleri ile sepet değerini artırır.",
  "sorun": "Checkout tamamlandıktan sonra ek satış fırsatı tema ile sunulmaz.",
