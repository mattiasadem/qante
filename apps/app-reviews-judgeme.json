{
  "id": "app-reviews-judgeme",
  "kategori": "reviews",
  "varyant": "judgeme",
  "scope": "in-flow",
  "amac": "Ürün ve mağaza güvenini artırmak için müşteri yorumlarını ve puanlarını vitrine taşır.",
  "sorun": "Tema PDP'leri varsayılan olarak müşteri yorumu ve fotoğraf UGC göstermez; satın alma kararı için güven sinyali eksik kalır.",
  "link": "https://apps.shopify.com/judgeme",
  "yuzey": [
    "review_stars",
    "review_widget",
    "review_carousel",
    "ugc_gallery",
    "review_floating_tab"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "PAGE_VIEW"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "INDEX"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read-products"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ayarlar": {
    "yildizOzetiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "yorumListesiGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "fotoYorumGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "carouselGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "floatingTabGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "minimumPuan": {
      "tip": "number",
      "zorunlu": false
    },
    "siralama": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "urunler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "manual",
        "limit": 12
      }
    }
  ],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:productCard.badge",
    "mount:section.after"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "native reviews + Lehte",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
