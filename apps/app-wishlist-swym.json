{
  "id": "app-wishlist-swym",
  "kategori": "wishlist",
  "varyant": "swym",
  "scope": "overlay",
  "amac": "Ürünleri favorilere eklemek ve listeyi drawer veya sayfada yönetmek için UI sağlar.",
  "yuzey": [
    "wishlist_button",
    "wishlist_drawer",
    "wishlist_page"
  ],
  "entegrasyon": [
    "app-embed",
    "app-block"
  ],
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "musteri",
      "source": "DataSource.customer"
    }
  ],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:productCard.badge",
    "mount:buyBox.after",
    "mount:header.utility"
  ],
  "bagimliliklar": [
    "product-info-main"
  ],
  "ikasKarsilik": "Favori Ürünler",
  "link": "https://apps.shopify.com/swym-relay",
  "sorun": "Ürünü beğenen ziyaretçi hemen satın almazsa tema onu geri getirecek mekanizma sunmaz.",
  "ayarlar": {
    "favoriButonuGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "anonimListe": {
      "tip": "boolean",
      "zorunlu": false
    },
    "fiyatDususUyarisi": {
      "tip": "boolean",
      "zorunlu": false
    },
    "stokGeldiUyarisi": {
      "tip": "boolean",
      "zorunlu": false
    }
  }
}
