{
  "id": "app-capture-justuno",
  "kategori": "capture",
  "varyant": "justuno",
  "scope": "overlay",
  "amac": "Popup ve flyout ile e-posta, SMS ve promosyon yakalama kampanyaları çalıştırır.",
  "sorun": "Tema tek newsletter bandı sunar; Justuno segmentasyon ve çoklu kampanya formatı sağlar.",
  "link": "https://apps.shopify.com/justuno-pop-ups-email-conversion",
  "yuzey": [
    "popup_modal",
    "flyout"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PAGE_VIEW",
    "CUSTOMER_REGISTER"
  ],
  "ikasSayfa": [
    "INDEX",
    "PRODUCT",
    "CUSTOM"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "storefront-script",
  "ikasKapsam": [
    "read_customers"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "baslik": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80
    },
    "kampanyaTipi": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40
    },
    "tetikleyici": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "musteri",
      "source": "DataSource.customer"
    }
  ],
  "actions": [
    "emit:newsletter.subscribe"
  ],
  "hookNoktalari": [
    "mount:footer.before"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "yok",
  "tespit": {
    "shopify": "",
