{
  "id": "app-payments-afterpay-osm",
  "kategori": "payments",
  "varyant": "afterpay-osm",
  "scope": "in-flow",
  "amac": "Ürün ve sepet sayfalarında Afterpay taksit bilgisini göstererek dönüşüm engelini azaltır.",
  "sorun": "BNPL seçeneği vitrinde belirtilmezse müşteri ödeme esnekliğini fark etmez ve sepetten vazgeçebilir.",
  "link": "https://apps.shopify.com/afterpay-messaging",
  "yuzey": [
    "bnpl_messaging"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block"
    ],
    "ikas": [
      "storefront-script"
    ]
  },
  "ikasTur": "yok",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "VIEW_CART",
    "BEGIN_CHECKOUT"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART",
    "CHECKOUT"
  ],
  "ayarlar": {
    "pdpMesajGoster": {
      "tip": "boolean",
      "zorunlu": true
    },
    "sepetMesajGoster": {
      "tip": "boolean",
      "zorunlu": false
    },
    "bolge": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 10
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "sepet",
      "source": "DataSource.cart"
    }
  ],
  "actions": [
    "yok"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:cartDrawer.footer"
  ],
  "bagimliliklar": [
    "product-info-main",
    "global-cart-drawer"
  ],
  "ikasKarsilik": "yok"
}
