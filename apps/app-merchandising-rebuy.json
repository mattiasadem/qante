{
  "id": "app-merchandising-rebuy",
  "kategori": "merchandising",
  "varyant": "rebuy",
  "scope": "overlay",
  "amac": "Sepet çekmecesi ve ürün sayfalarında kişiselleştirilmiş upsell ve cross-sell önerileri sunar.",
  "sorun": "Sepet ve PDP önerileri statik kalınca AOV artmaz; Rebuy davranışa göre upsell ve cross-sell sunar.",
  "link": "https://apps.shopify.com/rebuy",
  "yuzey": [
    "cart_drawer",
    "product_recs"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "app-block"
    ],
    "ikas": [
      "storefront-js-script"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "VIEW_CART",
    "ADD_TO_CART",
    "PRODUCT_VIEW"
  ],
  "ikasSayfa": [
    "CART",
    "PRODUCT"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "storefront-script",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [],
  "ikasYayin": "yok",
  "ikasHost": "yok",
  "ayarlar": {
    "sepetOnerisiAktif": {
      "tip": "boolean",
      "zorunlu": true
    },
    "pdpOnerisiAktif": {
      "tip": "boolean",
      "zorunlu": false
    },
    "oneriLimiti": {
      "tip": "number",
      "zorunlu": false
    },
    "kuralSeti": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 60
    },
    "oncelikliScript": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "CreateStorefrontJSScript.isHighPriority"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 120,
      "not": "script URL query, mağaza bazlı"
    }
  },
  "dataBindings": [
    {
      "name": "sepet",
      "source": "DataSource.cart"
    },
    {
      "name": "oneriler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "recommended",
        "limit": 4
      }
    },
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:cartDrawer.belowItems",
    "mount:buyBox.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "product-info-main"
  ],
  "ikasKarsilik": "cart Drawer + Kabile Sepet+",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
