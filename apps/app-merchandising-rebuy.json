{
  "id": "app-merchandising-rebuy",
  "kategori": "merchandising",
  "varyant": "rebuy",
  "scope": "overlay",
  "amac": "Sepet çekmecesi ve ürün sayfalarında kişiselleştirilmiş upsell ve cross-sell önerileri sunar.",
  "yuzey": [
    "cart_drawer",
    "product_recs"
  ],
  "entegrasyon": [
    "app-embed",
    "app-block"
  ],
  "dataBindings": [
    {
      "name": "sepet",
      "source": "DataSource.cart"
    },
    {
      "name": "oneriler",
      "source": "DataSource.productList",
      "params": {
        "kaynak": "recommended",
        "limit": 4
      }
    },
    {
      "name": "urun",
      "source": "DataSource.product"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:cartDrawer.belowItems",
    "mount:buyBox.after"
  ],
  "bagimliliklar": [
    "global-cart-drawer",
    "product-info-main"
  ],
  "ikasKarsilik": "cart Drawer + Kabile Sepet+",
  "link": "https://apps.shopify.com/rebuy",
  "sorun": "Sepet ve PDP önerileri statik kalınca AOV artmaz; Rebuy davranışa göre upsell ve cross-sell sunar.",
  "ayarlar": {
    "sepetOnerisiAktif": {
      "tip": "boolean",
      "zorunlu": true
    },
    "pdpOnerisiAktif": {
      "tip": "boolean",
      "zorunlu": false
    },
    "oneriLimiti": {
      "tip": "number",
      "zorunlu": false
    },
    "kuralSeti": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 60
    }
  }
}
