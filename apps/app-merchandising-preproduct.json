{
  "id": "app-merchandising-preproduct",
  "kategori": "merchandising",
  "varyant": "preproduct",
  "scope": "in-flow",
  "amac": "Stokta olmayan veya henüz çıkacak üründe Preorder butonu ve depozito ile erken satış almak.",
  "sorun": "Listing PreProduct next-gen pre-order (HTTP 200): pay-now, pay-later, deposits. ikas native preorder yok; karşılık studio-section (buton + trust_badge).",
  "link": "https://apps.shopify.com/preproduct",
  "yuzey": [
    "trust_badge"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "app-block"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "ADD_TO_CART",
    "VIEW_CART"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CATEGORY",
    "CART"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [
    "store/order/created",
    "store/product/updated"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "ctaEtiket": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40,
      "not": "Preorder buton yazısı"
    },
    "depozitoAcik": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "Listing deposits / pay-later vaat ediyor"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "sepet",
      "source": "DataSource.cart"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:buyBox.after",
    "mount:productCard.badge"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section: PDP Preorder CTA + rozet. Pay-later / depozito hunisi ikas checkout-extension ile birebir değil.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
