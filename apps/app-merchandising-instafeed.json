      "tip": "number",
      "zorunlu": false
    },
    "urunEtiketleme": {
      "tip": "boolean",
      "zorunlu": false
    },
    "layout": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 20
    }
  }
