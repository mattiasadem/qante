{
  "id": "app-merchandising-preorderly",
  "kategori": "merchandising",
  "varyant": "preorderly",
  "scope": "in-flow",
  "amac": "Çıkmamış veya tükenen üründe preorder, depozito ve teslim tarihi göstererek erken gelir almak.",
  "sorun": "Listing Preorderly: pre-orders, deposits, Ships by + countdown, mixed-cart notice, notify-me waitlist. Bu kayıt merchandising preorder; waitlist overlay ayrı capture değil. ikas native preorder yok.",
  "link": "https://apps.shopify.com/preorderly",
  "yuzey": [
    "trust_badge"
  ],
  "entegrasyon": {
    "shopify": [
      "app-embed",
      "app-block",
      "checkout-extension"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "ADD_TO_CART",
    "COMPLETE_CHECKOUT"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [
    "store/order/created"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "ctaEtiket": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 40,
      "not": "Preorder buton yazısı"
    },
    "teslimTarihiGoster": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "Listing Ships by date + countdown vaat ediyor"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "sepet",
      "source": "DataSource.cart"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:buyBox.after"
  ],
  "bagimliliklar": [],
