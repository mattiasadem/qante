{
  "id": "app-merchandising-product-options",
  "kategori": "merchandising",
  "varyant": "product-options",
  "scope": "in-flow",
  "amac": "Varyant swatch, özel seçenek ve hediye paketi ücretiyle PDP’de kişiselleştirme satmak.",
  "sorun": "Listing SC Product Options (HTTP 200; eski Bold Product Options ailesi). product-options-by-bss ayrı. ikas native yok; studio-section + embedded_form.",
  "link": "https://apps.shopify.com/product-options",
  "yuzey": [
    "embedded_form"
  ],
  "entegrasyon": {
    "shopify": [
      "app-block",
      "app-embed"
    ],
    "ikas": [
      "storefront-js-script",
      "webhook",
      "admin-iframe"
    ]
  },
  "ikasTur": "admin",
  "ikasOlaylar": [
    "PRODUCT_VIEW",
    "ADD_TO_CART"
  ],
  "ikasSayfa": [
    "PRODUCT",
    "CART"
  ],
  "ikasLink": "yok",
  "ikasSablon": "starter",
  "ikasHedef": "studio-section",
  "ikasKapsam": [
    "read_products",
    "read_orders"
  ],
  "ikasAksiyon": [],
  "ikasWebhook": [
    "store/order/created"
  ],
  "ikasYayin": "herkese-acik",
  "ikasHost": "external",
  "ayarlar": {
    "oncelikliScript": {
      "tip": "link",
      "zorunlu": true,
      "not": "Vitrin JS giriş adresi (merchant panelinden kopyalanır)"
    },
    "publicApiKey": {
      "tip": "text",
      "zorunlu": true,
      "maxLen": 80,
      "not": "Hesabın public/site anahtarı; gizli API anahtarı değil"
    },
    "baslik": {
      "tip": "text",
      "zorunlu": false,
      "maxLen": 80,
      "not": "Seçenek seti başlığı"
    },
    "hediyePaketi": {
      "tip": "boolean",
      "zorunlu": false,
      "not": "Listing gift wrap extra charge vaat ediyor"
    }
  },
  "dataBindings": [
    {
      "name": "urun",
      "source": "DataSource.product"
    },
    {
      "name": "sepet",
      "source": "DataSource.cart"
    }
  ],
  "actions": [
    "emit:cart.add"
  ],
  "hookNoktalari": [
    "mount:buyBox.after"
  ],
  "bagimliliklar": [],
  "ikasKarsilik": "Studio section: PDP özel seçenek / swatch formu. Gift wrap ücreti satır özelliği. Resmi ikas listing yok.",
  "tespit": {
    "shopify": "",
    "ikas": ""
  }
}
